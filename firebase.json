{
  "hosting": {
    "site": "noor-paigham",
    "public": "dist",
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/home/home-screen{,/**}",
        "destination": "/home/home-broadcast-studio/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|jsx|css|webp|png|jpg|jpeg|svg|gif|ttf|woff|woff2|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
